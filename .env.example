# Tennis API (RapidAPI) - for live matches and rankings
TENNIS_API_KEY=your_rapidapi_key_here
TENNIS_API_HOST=tennisapi1.p.rapidapi.com

# SerpAPI - for scheduled match data from Google Sports
SERPAPI_KEY=your_serpapi_key_here

# Live Tennis API (OPTIONAL) - additional source of scheduled/live matches.
# Leave unset to disable; everything else keeps working as before.
LIVETENNIS_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Application URLs
OAUTH_REDIRECT_URI=https://your-region-your-project.cloudfunctions.net/api_gateway/auth/callback
FRONTEND_URL=https://storage.googleapis.com/your-bucket/index.html

# GCP Project
GCP_PROJECT_ID=your-project-id

# Environment
ENVIRONMENT=development
